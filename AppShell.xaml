<?xml version="1.0" encoding="UTF-8" ?>
<Shell x:Class="VentasClaro.AppShell"
       xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:local="clr-namespace:VentasClaro"
       Shell.BackgroundColor="#D50000" Shell.ForegroundColor="White" Shell.TitleColor="White"
       Shell.TabBarBackgroundColor="White" Shell.TabBarForegroundColor="#D50000"
       Shell.TabBarTitleColor="#D50000" Shell.TabBarUnselectedColor="#888888">
    <TabBar>
        <ShellContent Title="Inicio" ContentTemplate="{DataTemplate local:HomePage}" />
        <ShellContent Title="Nueva venta" ContentTemplate="{DataTemplate local:NuevaVentaPage}" />
        <ShellContent Title="Resumen" ContentTemplate="{DataTemplate local:ResumenPage}" />
        <ShellContent Title="Planes" ContentTemplate="{DataTemplate local:PlanesPage}" />
        <ShellContent Title="Respaldo" ContentTemplate="{DataTemplate local:RespaldoPage}" />
    </TabBar>
</Shell>
